<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0-maccatalyst;net9.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>MediaHub</AssemblyName>
    <RootNamespace>MediaHub</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationTitle>MediaHub</ApplicationTitle>
    <ApplicationId>com.danielskliphosovsky.mediahub</ApplicationId>
    <ApplicationDisplayVersion>4.3.6</ApplicationDisplayVersion>
    <ApplicationVersion>4</ApplicationVersion>

    <!-- macOS -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">16.0</SupportedOSPlatformVersion>
    <!-- Windows -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- YoutubeExplode 6.6.x ships PolyShim-generated types with duplicate full
       names, which crashes the Mac Catalyst linker with MT2231 while trimming.
       Keep Mac Catalyst untrimmed (Windows already is). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <MtouchLink>None</MtouchLink>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CommunityToolkit.Maui" Version="9.0.0" />
    <PackageReference Include="YoutubeExplode" Version="6.6.3" />
    <PackageReference Include="SoundCloudExplode" Version="1.6.7" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.0" />
  </ItemGroup>

  <!-- TikTokExplode.dll is a self-contained reference library (no NuGet deps).
       Private=true copies it next to the app output on publish. -->
  <ItemGroup>
    <Reference Include="TikTokExplode">
      <HintPath>Resources\Libraries\TikTokExplode.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Images -->
  <ItemGroup>
    <MauiImage Include="Resources\Images\*" />
  </ItemGroup>

  <!-- Platform logos, kept as editable SVG files so they can be tweaked by
       hand and re-rasterized by Resizetizer on the next build. BaseSize is
       raised well above the 41px render size so the generated PNGs stay crisp
       at Windows DPI scales (1.0/1.25/1.5) instead of upscaling a small base. -->
  <ItemGroup>
    <MauiImage Include="Resources\Logos\*.svg" BaseSize="128,128" />
  </ItemGroup>

  <!-- App Icon and Splash Screen -->
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg"
              ForegroundFile="Resources\AppIcon\appiconfg.svg"
              Color="#6C5CE7" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg"
                      Color="#0F0F1A"
                      BaseSize="128,128" />
  </ItemGroup>

  <!-- Custom Fonts -->
  <ItemGroup>
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <!-- Raw Assets -->
  <ItemGroup>
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Localization resources -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings\AppResources.resx" />
    <EmbeddedResource Update="Resources\Strings\AppResources.ru.resx">
      <DependentUpon>AppResources.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>
